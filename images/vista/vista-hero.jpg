    <section id="carnets" class="club-section">
        <div class="club-wrap">
            <div class="section-head">
                <h2>Membresias y carnets</h2>
                <p>El modulo reconoce socios, carnets y descuentos sincronizados para restaurante y villas.</p>
            </div>
                        <div class="membership-showcase" data-membership-carousel>
                <div class="membership-carousel">
                    <div class="membership-track">
                                                        <article class="membership-slide is-carousel-slide is-active" data-membership-slide="0">
                        <div class="membership-copy">
                            <h3>2da Quincena agosto - 2025</h3>
                                                            <p>Acceso a carnet digital, reservas de villas y beneficios exclusivos del club.</p>
                                                        <div class="membership-meta">
                                                                <span>365 dias</span>
                                <span>0 invitados</span>
                            </div>
                        </div>
