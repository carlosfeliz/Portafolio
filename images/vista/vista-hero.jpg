<script>
    document.addEventListener('DOMContentLoaded', function () {
        const villaDetails = [{"id":6,"name":"Abey","description":null,"location":"Club Vista a las Montanas","capacity":8,"bedrooms":1,"bathrooms":1,"price_label":"$ 8,300.00 \/ noche","room_price_label":null,"partial_enabled":false,"images":[],"amenities":[]},{"id":5,"name":"casa blanca","description":null,"location":"Club Vista a las Montanas","capacity":4,"bedrooms":2,"bathrooms":1,"price_label":"$ 4,200.00 \/ noche","room_price_label":null,"partial_enabled":false,"images":[],"amenities":[]},{"id":3,"name":"Habitacion Compartida A","description":"Habitacion economica compartida cerca de la piscina.","location":"Area Piscina","capacity":1,"bedrooms":1,"bathrooms":1,"price_label":"$ 1,500.00 \/ noche","room_price_label":null,"partial_enabled":false,"images":[],"amenities":["Piscina","Wifi"]},{"id":2,"name":"Villa Deluxe 201","description":"Villa de lujo con jacuzzi y balcon privado.","location":"Bloque Este","capacity":2,"bedrooms":1,"bathrooms":1,"price_label":"$ 8,500.00 \/ noche","room_price_label":null,"partial_enabled":false,"images":[],"amenities":["Jacuzzi","Balcon","Aire","Wifi"]},{"id":1,"name":"Villa Familiar 101","description":"Villa espaciosa para familias con vista a la montana.","location":"Bloque Norte","capacity":6,"bedrooms":2,"bathrooms":2,"price_label":"$ 5,000.00 \/ noche","room_price_label":null,"partial_enabled":false,"images":[],"amenities":["Wifi","Aire","Vista a la montana"]},{"id":4,"name":"Villa Standard 301","description":"Villa acogedora para parejas.","location":"Bloque Sur","capacity":3,"bedrooms":1,"bathrooms":1,"price_label":"$ 3,500.00 \/ noche","room_price_label":null,"partial_enabled":false,"images":[],"amenities":["Aire","Wifi","Nevera"]}];
        const villaModal = document.getElementById('villaDetailModal');
        const villaModalClose = document.getElementById('villaModalClose');
        const villaModalMain = document.getElementById('villaModalMain');
        const villaModalThumbs = document.getElementById('villaModalThumbs');

        function setVillaModalImage(images, activeIndex) {
            villaModalMain.innerHTML = '';
            villaModalThumbs.innerHTML = '';

            if (!images.length) {
                villaModalMain.textContent = 'Sin imagen';
                return;
            }

            const mainImage = document.createElement('img');
            mainImage.src = images[activeIndex];
            mainImage.alt = 'Imagen de villa';
            villaModalMain.appendChild(mainImage);

            images.forEach(function (src, index) {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'villa-modal-thumb' + (index === activeIndex ? ' is-active' : '');
                const image = document.createElement('img');
                image.src = src;
                image.alt = 'Miniatura de villa';
                button.appendChild(image);
                button.addEventListener('click', function () {
                    setVillaModalImage(images, index);
                });
                villaModalThumbs.appendChild(button);
            });
        }

        function openVillaModal(id) {
            const villa = villaDetails.find(function (item) {
                return String(item.id) === String(id);
            });

            if (!villa || !villaModal) return;

            document.getElementById('villaModalTitle').textContent = villa.name || 'Villa';
            document.getElementById('villaModalLocation').textContent = villa.location || '';
            document.getElementById('villaModalDescription').textContent = villa.description || 'Sin descripcion disponible.';
            document.getElementById('villaModalPrice').textContent = villa.price_label || '';
            document.getElementById('villaModalCapacity').textContent = (villa.capacity || 0) + ' huespedes';
            document.getElementById('villaModalBedrooms').textContent = villa.bedrooms || 'N/D';
            document.getElementById('villaModalBathrooms').textContent = villa.bathrooms || 'N/D';
            document.getElementById('villaModalPartial').textContent = villa.partial_enabled ? 'Disponible' : 'Villa completa';
            document.getElementById('villaModalRoomPrice').textContent = villa.room_price_label || '';
            document.getElementById('villaModalReserveLink').href = "https:\/\/vista.todovirtual.cloud\/villas-publicas\/calendario" + '?villa_id=' + encodeURIComponent(villa.id);

            const amenities = document.getElementById('villaModalAmenities');
            amenities.innerHTML = '';
            (villa.amenities || []).forEach(function (item) {
                const tag = document.createElement('span');
                tag.textContent = item;
                amenities.appendChild(tag);
            });

            setVillaModalImage(villa.images || [], 0);
            villaModal.classList.add('is-open');
            villaModal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }

        function closeVillaModal() {
            if (!villaModal) return;
            villaModal.classList.remove('is-open');
            villaModal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        document.querySelectorAll('[data-villa-card]').forEach(function (card) {
            card.addEventListener('click', function () {
                openVillaModal(card.getAttribute('data-villa-card'));
            });
            card.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    openVillaModal(card.getAttribute('data-villa-card'));
                }
            });
        });

        if (villaModalClose) {
            villaModalClose.addEventListener('click', closeVillaModal);
        }
        if (villaModal) {
            villaModal.addEventListener('click', function (event) {
                if (event.target === villaModal) {
                    closeVillaModal();
                }
            });
        }
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeVillaModal();
            }
        });

        const slides = document.querySelectorAll('.club-hero-slide');
        if (slides.length > 1) {
            let current = 0;
            setInterval(function () {
                slides[current].classList.remove('active');
                current = (current + 1) % slides.length;
                slides[current].classList.add('active');
            }, 6500);
        }

        const membershipCarousel = document.querySelector('[data-membership-carousel]');
        const membershipSelect = document.getElementById('membershipTypeSelect');
        const membershipPayTotal = document.getElementById('membershipPayTotal');

        if (membershipSelect && membershipPayTotal) {
            const currency = "$";
            const formatter = new Intl.NumberFormat('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const updateMembershipPrice = function () {
                const option = membershipSelect.options[membershipSelect.selectedIndex];
                const price = parseFloat(option ? option.getAttribute('data-price') || '0' : '0');
                membershipPayTotal.textContent = currency + ' ' + formatter.format(isNaN(price) ? 0 : price);
            };
            membershipSelect.addEventListener('change', updateMembershipPrice);
            updateMembershipPrice();
        }

        if (!membershipCarousel) return;

        const membershipSlides = membershipCarousel.querySelectorAll('[data-membership-slide]');
        const membershipDots = membershipCarousel.querySelectorAll('[data-membership-dot]');
        const prev = membershipCarousel.querySelector('[data-membership-prev]');
        const next = membershipCarousel.querySelector('[data-membership-next]');
        let membershipCurrent = 0;

        function showMembership(index) {
            if (!membershipSlides.length) return;

            membershipCurrent = (index + membershipSlides.length) % membershipSlides.length;
            membershipSlides.forEach(function (slide, slideIndex) {
                slide.classList.toggle('is-active', slideIndex === membershipCurrent);
            });
            membershipDots.forEach(function (dot, dotIndex) {
                dot.classList.toggle('is-active', dotIndex === membershipCurrent);
            });
        }

        if (prev && next && membershipSlides.length > 1) {
            prev.addEventListener('click', function () {
                showMembership(membershipCurrent - 1);
            });
            next.addEventListener('click', function () {
                showMembership(membershipCurrent + 1);
            });
            membershipDots.forEach(function (dot, dotIndex) {
                dot.addEventListener('click', function () {
                    showMembership(dotIndex);
                });
            });
            setInterval(function () {
                showMembership(membershipCurrent + 1);
            }, 7200);
        }
    });
</script>

    <script src="https://vista.todovirtual.cloud/assets/js/bootstrap.min.js"></script>
    <script src="https://vista.todovirtual.cloud/assets/js/plugins/metisMenu/jquery.metisMenu.js"></script>
    <script src="https://vista.todovirtual.cloud/assets/js/plugins/slimscroll/jquery.slimscroll.min.js"></script>
    <script src="https://vista.todovirtual.cloud/assets/js/inspinia.js"></script>
    <script src="https://vista.todovirtual.cloud/assets/js/plugins/pace/pace.min.js"></script>
    <script src="https://vista.todovirtual.cloud/assets/js/plugins/peity/jquery.peity.min.js"></script>
    <script src="https://vista.todovirtual.cloud/assets/js/demo/peity-demo.js"></script>
    <script src="https://vista.todovirtual.cloud/assets/js/plugins/sweetalert/sweetalert.min.js"></script>

    <script>
        $(document).ready(function () {
            var sessionSwal = {"icon":"info","title":"No disponible","text":"La vista solicitada no existe o no esta disponible."};
            if (!sessionSwal || typeof swal !== 'function') return;

            swal({
                title: sessionSwal.title || 'Aviso',
                text: sessionSwal.text || '',
                type: sessionSwal.icon || 'info',
                confirmButtonText: sessionSwal.confirmButtonText || 'Entendido'
            });
        });
    </script>

    <script>
        (function () {
            function confirmAction(options, callback) {
                if (window.Swal && typeof window.Swal.fire === 'function') {
                    window.Swal.fire({
                        title: options.title,
                        text: options.text,
                        icon: options.icon || 'warning',
                        showCancelButton: true,
                        confirmButtonText: options.confirmButtonText || 'Confirmar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: options.confirmButtonColor
                    }).then(function (result) {
                        if (result.isConfirmed) callback();
                    });
                    return;
                }

                if (typeof swal === 'function') {
                    var swalResult = swal({
                        title: options.title,
                        text: options.text,
                        type: options.icon || 'warning',
                        showCancelButton: true,
                        confirmButtonColor: options.confirmButtonColor || '#DD6B55',
                        confirmButtonText: options.confirmButtonText || 'Confirmar',
                        cancelButtonText: 'Cancelar',
                    }, function (isConfirm) {
                        if (isConfirm) callback();
                    });

                    if (swalResult && typeof swalResult.then === 'function') {
                        swalResult.then(function (result) {
                            if (result === true || (result && (result.value === true || result.isConfirmed === true))) {
                                callback();
                            }
                        }).catch(function () {});
                    }
                    return;
                }

                if (window.confirm(options.fallbackText || options.title)) callback();
            }

            function confirmDelete(callback) {
                confirmAction({
                    title: 'Eliminar registro?',
                    text: 'Esta accion no se puede deshacer.',
                    icon: 'warning',
                    confirmButtonText: 'Si, eliminar',
                    confirmButtonColor: '#DD6B55',
                    fallbackText: 'Eliminar registro?'
                }, callback);
            }

            function confirmLogout(callback) {
                confirmAction({
                    title: 'Cerrar sesion?',
                    text: 'Vas a salir de tu cuenta.',
                    icon: 'warning',
                    confirmButtonText: 'Si, salir',
                    confirmButtonColor: '#1ab394',
                    fallbackText: 'Cerrar sesion?'
                }, callback);
            }

            function isDeleteForm(form) {
                if (!form) return false;
                var methodInput = form.querySelector('input[name="_method"]');
                return methodInput && String(methodInput.value).toUpperCase() === 'DELETE';
            }

            function formForTrigger(trigger) {
                if (!trigger) return null;
                var formId = trigger.getAttribute('form');
                if (formId) return document.getElementById(formId);
                return trigger.closest ? trigger.closest('form') : null;
            }

            function isDeleteLink(link) {
                if (!link || !link.matches || !link.matches('a')) return false;
                var href = link.getAttribute('href') || '';
                if (!href || href === '#' || /^javascript:/i.test(href)) return false;
                var classes = link.className || '';
                return link.matches('a.delete, a.js-delete-link, [data-confirm-action="delete"]')
                    || /(?:delete|destroy|eliminar)/i.test(href)
                    || /(?:delete|destroy|eliminar)/i.test(classes);
            }

            function isLogoutLink(link) {
                if (!link || !link.matches || !link.matches('a')) return false;
                var href = link.getAttribute('href') || '';
                return link.matches('[data-confirm-action="logout"]') || /(?:^|\/)logout(?:[\/?#]|$)/i.test(href);
            }

            function submitConfirmedForm(form) {
                form.dataset.swalConfirmed = '1';
                if (typeof form.submit === 'function') {
                    form.submit();
                } else {
                    HTMLFormElement.prototype.submit.call(form);
                }
            }

            function submitLogout(trigger) {
                var href = trigger.href || 'https://vista.todovirtual.cloud/logout';
                var form = document.createElement('form');
                var csrf = document.querySelector('meta[name="csrf-token"]');

                form.method = 'POST';
                form.action = href;
                form.style.display = 'none';

                if (csrf) {
                    var token = document.createElement('input');
                    token.type = 'hidden';
                    token.name = '_token';
                    token.value = csrf.getAttribute('content');
                    form.appendChild(token);
                }

                document.body.appendChild(form);
                try {
                    HTMLFormElement.prototype.submit.call(form);
                } catch (e) {
                    window.location.href = href;
                }
            }

            document.addEventListener('click', function (event) {
                var trigger = event.target.closest ? event.target.closest('button, input[type="submit"], a') : null;
                if (!trigger) return;

                var form = formForTrigger(trigger);
                if (form && isDeleteForm(form) && form.dataset.swalConfirmed !== '1') {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    confirmDelete(function () {
                        submitConfirmedForm(form);
                    });
                    return;
                }

                if (isLogoutLink(trigger) && trigger.dataset.swalConfirmed !== '1') {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    confirmLogout(function () {
                        trigger.dataset.swalConfirmed = '1';
                        submitLogout(trigger);
                    });
                    return;
                }

                if (isDeleteLink(trigger) && trigger.dataset.swalConfirmed !== '1') {
                    var href = trigger.getAttribute('href');
                    if (!href || href === '#') return;
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    confirmDelete(function () {
                        trigger.dataset.swalConfirmed = '1';
                        window.location.href = trigger.href;
                    });
                }
            }, true);

            document.addEventListener('submit', function (event) {
                var form = event.target;
                if (!isDeleteForm(form) || form.dataset.swalConfirmed === '1') return;

                event.preventDefault();
                event.stopImmediatePropagation();
                confirmDelete(function () {
                    submitConfirmedForm(form);
                });
            }, true);
        })();
    </script>

    </body>

</html>
