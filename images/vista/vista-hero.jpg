<body class="gray-bg">
    
<style>
    body.gray-bg { background: #f6f8f7; }
    .club-site { color: #17202a; background: #f6f8f7; min-height: 100vh; }
    .club-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 30; background: rgba(12, 30, 24, .86); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255,255,255,.12); }
    .club-nav-inner { max-width: 1180px; margin: 0 auto; padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
    .club-brand { color: #fff; font-weight: 800; font-size: 18px; letter-spacing: 0; }
    .club-links { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .club-links a { color: #edf7f1; font-size: 13px; font-weight: 700; }
    .club-links .club-action { background: #f5c542; color: #153b2c; padding: 8px 12px; border-radius: 5px; }
    .club-links .club-account { border: 1px solid rgba(255,255,255,.45); padding: 7px 10px; border-radius: 5px; }
    .club-hero { min-height: 92vh; position: relative; overflow: hidden; color: #fff; display: flex; align-items: end; }
    .club-hero-slide { position: absolute; inset: 0; opacity: 0; background-size: cover; background-position: center; transition: opacity 900ms ease; }
    .club-hero-slide.active { opacity: 1; }
    .club-hero-slide::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5,12,10,.16), rgba(5,12,10,.78)); }
    .club-hero-fallback { background: linear-gradient(135deg, #12372a, #276749); }
    .club-hero-content { position: relative; z-index: 2; width: 100%; max-width: 1180px; margin: 0 auto; padding: 120px 20px 86px; }
    .club-hero h1 { max-width: 760px; font-size: clamp(40px, 7vw, 76px); line-height: .98; font-weight: 900; margin: 0 0 18px; letter-spacing: 0; }
    .club-hero p { max-width: 660px; font-size: 18px; line-height: 1.6; color: #e6f1ea; margin-bottom: 26px; }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .hero-actions a { border-radius: 5px; padding: 12px 18px; font-weight: 800; }
    .primary-link { background: #f5c542; color: #17382c; }
    .secondary-link { background: rgba(255,255,255,.14); color: #fff; border: 1px solid rgba(255,255,255,.38); }
    .club-section { padding: 58px 20px; }
    .club-section.alt { background: #fff; }
    .club-wrap { max-width: 1180px; margin: 0 auto; }
    .section-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
    .section-head h2 { margin: 0; font-size: 30px; font-weight: 900; letter-spacing: 0; }
    .section-head p { max-width: 560px; color: #5f6f68; margin: 0; line-height: 1.55; }
    .villa-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .villa-card { background: #fff; border: 1px solid #dfe7e2; border-radius: 8px; overflow: hidden; min-height: 100%; }
    .villa-card.is-clickable { cursor: pointer; transition: transform 160ms ease, box-shadow 160ms ease; }
    .villa-card.is-clickable:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(15, 23, 42, .12); }
    .villa-card img { width: 100%; height: 210px; object-fit: cover; background: #dfe7e2; }
    .villa-card-body { padding: 16px; }
    .villa-card h3 { margin: 0 0 8px; font-size: 20px; font-weight: 800; }
    .villa-card-body p.muted + p.muted { display: none; }
    .muted { color: #64746c; }
    .price { color: #1c7c54; font-weight: 900; font-size: 20px; margin-top: 12px; }
    .feature-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .feature { background: #fff; border: 1px solid #dfe7e2; border-radius: 8px; padding: 18px; }
    .feature-media { height: 132px; margin: -18px -18px 14px; background: #e7eee9; overflow: hidden; border-radius: 8px 8px 0 0; display: flex; align-items: center; justify-content: center; color: #74837b; }
    .feature-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .feature i { color: #1c7c54; font-size: 24px; margin-bottom: 10px; }
    .feature h3 { margin: 0 0 8px; font-size: 17px; font-weight: 800; }
    .membership-showcase { position: relative; }
    .membership-carousel { position: relative; overflow: hidden; }
    .membership-track { position: relative; min-height: 390px; }
    .membership-slide { display: grid; grid-template-columns: minmax(280px, .8fr) minmax(420px, 1fr); gap: 56px; align-items: center; min-height: 390px; padding: 18px 48px; }
    .membership-slide.is-carousel-slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; pointer-events: none; transform: translateX(28px); transition: opacity 360ms ease, transform 360ms ease, visibility 360ms ease; }
    .membership-slide.is-active { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(0); }
    .membership-copy { max-width: 430px; }
    .membership-copy h3 { margin: 0 0 14px; font-size: 30px; line-height: 1.1; font-weight: 900; color: #142033; }
    .membership-copy p, .membership-copy li { color: #38455a; font-size: 16px; line-height: 1.65; }
    .membership-copy p { margin: 0 0 16px; }
    .membership-copy ul { margin: 0 0 16px; padding-left: 0; list-style: none; }
    .membership-copy li { position: relative; padding-left: 22px; }
    .membership-copy li::before { content: ""; position: absolute; left: 0; top: .72em; width: 7px; height: 7px; border-radius: 50%; background: #1c7c54; }
    .membership-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
    .membership-meta span { border: 1px solid #d7e1db; border-radius: 999px; color: #17382c; background: #fff; padding: 7px 10px; font-size: 12px; font-weight: 800; }
    .membership-card-stage { position: relative; display: flex; justify-content: center; padding: 0 34px; }
    .membership-nav { position: absolute; top: 50%; left: calc(43% + 34px); right: 12px; z-index: 6; display: flex; justify-content: space-between; pointer-events: none; transform: translateY(-50%); }
    .membership-nav button { width: 38px; height: 38px; border: 1px solid #d7e1db; border-radius: 50%; background: #fff; color: #17382c; box-shadow: 0 8px 18px rgba(15, 23, 42, .12); pointer-events: auto; display: flex; align-items: center; justify-content: center; }
    .membership-nav button:disabled { opacity: .35; cursor: default; }
    .membership-nav button:focus { outline: 2px solid #f5c542; outline-offset: 2px; }
    .membership-dots { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 22px; }
    .membership-dot { width: 9px; height: 9px; border: 0; border-radius: 50%; background: #c9d6cf; padding: 0; transition: width 180ms ease, background 180ms ease; }
    .membership-dot.is-active { width: 28px; border-radius: 999px; background: #1c7c54; }
    .membership-request { margin-top: 28px; background: #fff; border: 1px solid #dfe7e2; border-radius: 8px; padding: 18px; }
    .membership-request h3 { margin: 0 0 14px; font-size: 20px; font-weight: 900; }
    .membership-request-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .membership-request label { display: block; font-size: 12px; font-weight: 800; color: #38455a; margin-bottom: 6px; }
    .membership-request input, .membership-request select, .membership-request textarea { width: 100%; border: 1px solid #ced8d2; border-radius: 5px; padding: 9px 10px; }
    .membership-request textarea { min-height: 74px; resize: vertical; }
    .membership-request .full { grid-column: 1 / -1; }
    .membership-pay-summary { background: #eef7f1; border: 1px solid #cfe3d7; border-radius: 6px; padding: 12px; color: #17382c; font-weight: 800; }
    .membership-pay-summary small { display: block; color: #5f6f68; font-weight: 600; margin-top: 4px; }
    .public-carnet-card { width: 100%; max-width: 526px; aspect-ratio: 526 / 306; position: relative; overflow: hidden; border-radius: 8px; background: #e5e7eb; box-shadow: 0 2px 8px rgba(0,0,0,.22); color: #fff; }
    .public-carnet-photo { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
    .public-carnet-overlay { position: absolute; inset: 0; width: 65%; z-index: 1; }
    .public-carnet-content { position: absolute; top: 18px; left: 16px; z-index: 2; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,.45); }
    .public-carnet-content img { height: 38px; margin-bottom: 26px; filter: drop-shadow(0 1px 2px rgba(255,255,255,.4)); }
    .public-carnet-holder { font-size: 22px; line-height: 1.1; font-weight: 900; margin-bottom: 18px; }
    .public-carnet-type { font-size: 20px; line-height: 1.1; font-weight: 900; margin-bottom: 8px; }
    .public-carnet-data { font-size: 16px; line-height: 1.42; font-weight: 800; }
    .public-carnet-qr { position: absolute; right: 16px; bottom: 16px; z-index: 2; background: #fff; padding: 5px; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,.18); }
    .public-carnet-qr img { width: 72px; height: 72px; display: block; }
    .public-carnet-property { position: absolute; left: 16px; bottom: 14px; z-index: 2; color: #fff; font-size: 14px; font-weight: 900; text-shadow: 0 1px 2px rgba(0,0,0,.5); }
    .menu-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .menu-item { background: #fff; border: 1px solid #dfe7e2; border-radius: 8px; overflow: hidden; }
    .menu-img { height: 132px; background: #e7eee9; display: flex; align-items: center; justify-content: center; color: #74837b; }
    .menu-img img { width: 100%; height: 132px; object-fit: cover; }
    .menu-body { padding: 13px; }
    .story-media { height: 210px; background: #e7eee9; display: flex; align-items: center; justify-content: center; color: #74837b; overflow: hidden; }
    .story-media img, .story-media iframe { width: 100%; height: 100%; display: block; border: 0; }
    .story-media img { object-fit: cover; }
    .calendar-callout { background: #12372a; color: #fff; border-radius: 8px; padding: 28px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 18px; }
    .calendar-callout h2 { margin: 0 0 8px; font-size: 28px; font-weight: 900; }
    .calendar-callout p { color: #dce8e1; margin: 0; }
    .contact-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .contact-item { background: #fff; border: 1px solid #dfe7e2; border-radius: 8px; padding: 16px; }
    .club-footer h2 { margin: 0 0 16px; color: #fff; font-size: 20px; font-weight: 800; letter-spacing: 0; }
    .footer-socials { display: flex; align-items: center; justify-content: center; gap: 24px; margin-bottom: 22px; }
    .footer-socials a { color: #fff; font-size: 25px; line-height: 1; }
    .footer-socials a:hover { color: #f5c542; }
    .club-footer p { margin: 0; font-size: 16px; color: #edf7f1; }
    .villa-modal { position: fixed; inset: 0; z-index: 80; display: none; align-items: center; justify-content: center; padding: 22px; background: rgba(6, 15, 12, .72); }
    .villa-modal.is-open { display: flex; }
    .villa-modal-panel { width: min(1040px, 100%); max-height: 92vh; overflow-y: auto; background: #fff; border-radius: 8px; box-shadow: 0 22px 70px rgba(0,0,0,.34); }
    .villa-modal-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 18px 20px; border-bottom: 1px solid #e3ebe6; }
    .villa-modal-head h2 { margin: 0 0 5px; font-size: 26px; font-weight: 900; }
    .villa-modal-close { border: 0; width: 36px; height: 36px; border-radius: 50%; background: #eef2f0; color: #17382c; }
    .villa-modal-body { display: grid; grid-template-columns: minmax(280px, 1.1fr) minmax(280px, .9fr); gap: 22px; padding: 20px; }
    .villa-modal-main { height: 390px; background: #e7eee9; border-radius: 8px; overflow: hidden; display: flex; align-items: center; justify-content: center; color: #74837b; }
    .villa-modal-main img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .villa-modal-thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(74px, 1fr)); gap: 8px; margin-top: 10px; }
    .villa-modal-thumb { height: 62px; border: 2px solid transparent; border-radius: 5px; overflow: hidden; background: #eef2f0; padding: 0; }
    .villa-modal-thumb.is-active { border-color: #1c7c54; }
    .villa-modal-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .villa-modal-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 16px 0; }
    .villa-modal-fact { border: 1px solid #dfe7e2; border-radius: 8px; padding: 11px; }
    .villa-modal-fact strong { display: block; color: #17382c; font-size: 18px; }
    .villa-modal-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .villa-modal-tags span { border: 1px solid #d7e1db; border-radius: 999px; padding: 7px 10px; color: #17382c; font-size: 12px; font-weight: 800; }
    footer.club-footer { background: #0c1e18; color: #dbe7df; padding: 26px 20px; text-align: center; }
    @media (max-width: 980px) {
        .villa-grid, .feature-grid, .menu-grid, .contact-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .membership-request-grid { grid-template-columns: 1fr; }
        .membership-slide, .calendar-callout, .villa-modal-body { grid-template-columns: 1fr; }
        .membership-slide { padding: 12px 0; }
        .membership-track { min-height: 650px; }
        .membership-nav { left: 0; right: 0; }
        .villa-modal-main { height: 280px; }
    }
    @media (max-width: 640px) {
        .club-links a:not(.club-action):not(.club-account) { display: none; }
        .villa-grid, .feature-grid, .menu-grid, .contact-strip { grid-template-columns: 1fr; }
        .membership-slide { gap: 22px; min-height: auto; }
        .membership-track { min-height: 590px; }
        .membership-copy h3 { font-size: 24px; }
        .membership-card-stage { padding: 0 26px; }
        .section-head { display: block; }
        .club-hero { min-height: 82vh; }
    }
</style>

